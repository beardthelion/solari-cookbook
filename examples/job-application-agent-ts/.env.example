# Copy to .env and fill in. Everything is optional except SOLARI_API_KEY.
# The example also reads values already exported in your shell, which take
# precedence over this file.

# Solari API key — required. Get one at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Optional: Solari API base URL (default https://api.getsolari.com). The
# sandbox SDK client (SandboxClient) requires an explicit baseUrl, so this
# value is passed to it; the browser client defaults internally.
# SOLARI_BASE_URL=https://api.getsolari.com

# Job posting to read with the cloud browser.
# Default: https://pinetree-research.com/careers
# JOB_URL=https://pinetree-research.com/careers

# Persona JSON file describing who the agent is applying as.
# Default: ./persona.sample.json (resolved relative to the example directory).
# The persona's resumeFile field resolves relative to the persona file itself.
# PERSONA_PATH=./persona.sample.json

# --- Optional LLM tailoring -------------------------------------------------
# With no LLM credentials the run uses deterministic tailoring. Anthropic is
# enabled whenever ANTHROPIC_API_KEY is set; an OpenAI-compatible endpoint is
# enabled only when BOTH OPENAI_API_KEY and OPENAI_BASE_URL are set.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
